{
  "name": "absensi-dapur",
  "version": "1.0.0",
  "private": true,
  "description": "Sistem Absensi Dapur MBG — clock in/out dengan selfie & geofence GPS, rekap & ekspor untuk admin.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "next build",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx",
    "db:init": "node scripts/init-db.mjs",
    "db:backup": "node --env-file=.env.local scripts/backup-db.mjs",
    "db:restore": "node scripts/restore-db.mjs",
    "test:ui": "playwright test",
    "test:mobile": "node tests/mobile-checks.mjs",
    "test:mobile:integration": "node tests/mobile-integration.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "exceljs": "^4.4.0",
    "html-to-image": "^1.11.13",
    "jose": "^5.9.6",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "next": "^15.1.6",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.14",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
